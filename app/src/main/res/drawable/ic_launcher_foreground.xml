<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 아이콘 전경 레이어 (design/ic_launcher_readytogo.svg의 foreground).

  **원본에서 0.82배로 줄였다.** adaptive icon에서 어느 런처에서나 보이는 것이 보장되는 영역은
  가운데 66dp(18~90)인데, 원본은 핀 오른쪽이 x=95까지 나가 원형 마스크에서 잘렸다.
  가운데를 기준으로 줄여 구도는 그대로 두고 잘림만 없앤다.

  **점선 궤적을 점 10개로 그린다.** 벡터 드로어블에는 SVG의 stroke-dasharray가 없다.
  원본 곡선 위를 일정 간격으로 샘플링한 좌표에 지름 5의 점을 찍어 같은 모양을 낸다.
  (워드마크 쪽은 Canvas라 진짜 점선을 쓴다 — Wordmark.kt 참고.)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82">

        <!-- 점선 궤적 -->
        <path android:fillColor="#FFFFFF" android:pathData="M27.75,64 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M34,58.1 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M40.4,54.4 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M46.6,51.8 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M52.4,48.8 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M57.3,44.1 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M60,39.5 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M63,33.9 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M67.6,28.7 a2.5,2.5 0 1,0 0.1,0 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M73,26.3 a2.5,2.5 0 1,0 0.1,0 z" />

        <!-- 비행기 (출발점) -->
        <group
            android:translateX="24"
            android:translateY="76"
            android:rotation="-40">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M0,-10 l3,7 l9,6 l-1,3 l-8,-3 l-1,6 l3,2 l-1,2 l-4,-1 l-4,1 l-1,-2 l3,-2 l-1,-6 l-8,3 l-1,-3 l9,-6 z" />
        </group>

        <!-- 핀 (도착점) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M84,18 a11,11 0 0 1 11,11 c0,8 -11,20 -11,20 s-11,-12 -11,-20 a11,11 0 0 1 11,-11 z" />
        <path
            android:fillColor="#F43F5E"
            android:pathData="M84,25 a4,4 0 1,0 0.1,0 z" />
    </group>
</vector>
