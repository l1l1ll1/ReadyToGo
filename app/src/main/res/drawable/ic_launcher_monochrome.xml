<?xml version="1.0" encoding="utf-8"?>
<!--
  테마 아이콘(안드로이드 13+)용 단색 실루엣.

  **전경 그림의 알파만 쓴다.** 시스템이 이 그림을 자기 색으로 덮어 칠하는데, 색이 여러 개인
  PNG를 그대로 넘기면 알파가 있는 곳이 전부 한 색으로 뭉개져 덩어리처럼 보인다.
  tint를 걸어 미리 단색으로 만들어 두면 모양(알파)만 남는다.

  흰색으로 칠해 두는 이유: 실제로 흰색이 나오지는 않는다. 시스템이 다시 칠한다.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_launcher_art"
    android:tint="#FFFFFF"
    android:gravity="fill" />
