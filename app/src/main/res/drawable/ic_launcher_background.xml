<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 아이콘 배경 레이어 (design/ic_launcher_readytogo.svg의 background).

  108dp는 adaptive icon의 전체 영역이다. 런처가 마스크로 잘라내므로 배경은 끝까지 채운다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      노을 그라데이션.

      SVG의 linearGradient(0,0 → 1,1)를 그대로 옮긴 것이다. 벡터 드로어블은 비율 좌표를
      쓰지 않아 viewport 값(0,0 → 108,108)으로 적는다.
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FDE68A" />
                <item android:offset="0.55" android:color="#FB923C" />
                <item android:offset="1" android:color="#F43F5E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 전경을 받쳐 주는 옅은 원. 궤적이 그라데이션 가운데에 묻히지 않게 한다. -->
    <path
        android:pathData="M54,22 a32,32 0 1,0 0.1,0 z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.18" />
</vector>
