<?xml version="1.0" encoding="utf-8"?>
<!--
  시스템이 앱을 띄우는 동안(= 우리 Compose 화면이 그려지기 전) 깔리는 배경.

  **왜 필요한가**: 기본값이 흰색이라 앱을 누르면 흰 화면이 한 번 번쩍인 뒤 노을 스플래시가
  나왔다. 같은 노을을 깔아 두면 그 경계가 보이지 않는다.

  core-splashscreen 라이브러리를 쓰지 않는 이유: 아이콘 애니메이션 같은 기능이 필요 없고,
  windowBackground 한 줄로 끝나는 일에 의존성을 더할 이유가 없다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FDE68A"
        android:centerColor="#FB923C"
        android:endColor="#F43F5E" />
</shape>
