<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 아이콘 배경 레이어 (design/ic_launcher_readytogo.svg의 background).

  108dp는 adaptive icon의 전체 영역이다. 런처가 마스크로 잘라내므로 배경은 끝까지 채운다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      노을 그라데이션.

      **범위를 108이 아니라 18~90으로 좁혔다.** 런처는 108dp 중 가운데 72dp만 보여주고
      원형 마스크면 그보다 더 잘라낸다. 0→108로 깔면 양 끝의 노랑과 자주가 잘려 나가고
      가운데 주황 한 색만 남아 "흐린 주황 원"이 됐다. 보이는 구간 안에 세 색이 다 들어오게
      시작·끝을 당긴다. 바깥은 끝 색으로 채워진다(기본 clamp).
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#FDE68A" />
                <item android:offset="0.55" android:color="#FB923C" />
                <item android:offset="1" android:color="#F43F5E" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      전경을 받쳐 주는 옅은 원. 궤적이 그라데이션 가운데에 묻히지 않게 한다.

      **처음보다 작고 옅게 잡았다(r 34→28, 18%→10%).** 런처가 원형 마스크로 자르고 나면
      보이는 영역 대부분을 이 원이 덮어서, 노을 세 색이 흐린 주황 하나로 읽혔다.
    -->
    <path
        android:pathData="M54,28 a26,26 0 1,0 0.1,0 z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.10" />
</vector>
